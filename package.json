{
  "name": "base-swap-indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Indexes Uniswap V3 WETH/USDC swaps on Base, stores them in SQLite, and serves them via a REST API and dashboard.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "index": "node --experimental-strip-types src/indexer/cli.ts",
    "index:follow": "node --experimental-strip-types src/indexer/cli.ts --follow",
    "api": "node --experimental-strip-types src/api/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings tools/run-tests.mjs",
    "smoke:dashboard": "node --no-warnings --experimental-strip-types tools/smoke-dashboard.ts && node --no-warnings tools/check-dashboard.mjs .",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "fastify": "^5.12.4",
    "viem": "^2.56.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.9.3"
  }
}
